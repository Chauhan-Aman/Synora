generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  preferences     String?          @default("")
  annotations     Annotation[]
  artifacts       Artifact[]
  chatSessions    ChatSession[]
  chunks          Chunk[]
  collections     Collection[]
  entities        Entity[]
  flashcards      Flashcard[]
  insights        Insight[]
  recommendations Recommendation[]
  summaries       Summary[]
  topics          Topic[]
}

model Artifact {
  id          String       @id @default(uuid())
  sourceUrl   String?
  content     String?
  type        String
  status      String       @default("pending")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  title       String?
  userId      String
  annotations Annotation[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      Chunk[]
  flashcards  Flashcard[]
  summary     Summary?
  collections Collection[] @relation("ArtifactToCollection")
  entities    Entity[]     @relation("ArtifactToEntity")
  topics      Topic[]      @relation("ArtifactToTopic")
}

model Chunk {
  id           String                   @id @default(uuid())
  text         String
  embedding    Unsupported("vector")?
  searchVector Unsupported("tsvector")?
  userId       String
  artifactId   String
  artifact     Artifact                 @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Summary {
  id         String   @id @default(uuid())
  text       String
  artifactId String   @unique
  userId     String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Topic {
  id        String     @id @default(uuid())
  name      String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts Artifact[] @relation("ArtifactToTopic")

  @@unique([name, userId])
}

model Entity {
  id        String     @id @default(uuid())
  name      String
  type      String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts Artifact[] @relation("ArtifactToEntity")

  @@unique([name, type, userId])
}

model Flashcard {
  id             String   @id @default(uuid())
  question       String
  answer         String
  nextReviewDate DateTime @default(now())
  interval       Int      @default(0)
  easeFactor     Float    @default(2.5)
  repetitions    Int      @default(0)
  userId         String
  artifactId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  artifact       Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id          String   @id @default(uuid())
  title       String
  description String
  reasoning   String
  type        String
  imageUrl    String?
  status      String   @default("UNREAD")
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Collection {
  id        String     @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts Artifact[] @relation("ArtifactToCollection")

  @@unique([name, userId])
}

model Insight {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String
  sources     String[]
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Annotation {
  id         String   @id @default(uuid())
  text       String
  userId     String
  artifactId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String?
  userId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String      @id @default(uuid())
  role      String
  content   String
  sessionId String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
