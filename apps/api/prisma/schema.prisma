generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Artifact {
  id        String   @id @default(uuid())
  sourceUrl String?
  content   String?
  type      String   // e.g. "URL", "TEXT", "IMAGE", "PDF", "AUDIO"
  status    String   @default("pending") // e.g. "pending", "processing", "completed", "failed"
  
  embedding Unsupported("vector(768)")?

  summary   Summary?
  topics    Topic[]
  entities  Entity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Summary {
  id         String   @id @default(uuid())
  text       String
  artifactId String   @unique
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
}

model Topic {
  id        String     @id @default(uuid())
  name      String     @unique
  artifacts Artifact[]
}

model Entity {
  id        String     @id @default(uuid())
  name      String
  type      String     // e.g., "PERSON", "ORGANIZATION", "LOCATION"
  artifacts Artifact[]

  @@unique([name, type])
}
