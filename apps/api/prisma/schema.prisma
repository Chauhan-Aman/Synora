generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artifacts    Artifact[]
  topics       Topic[]
  entities     Entity[]
  summaries    Summary[]
  chunks       Chunk[]
  flashcards   Flashcard[]
  recommendations Recommendation[]
}

model Artifact {
  id        String   @id @default(uuid())
  title     String?
  sourceUrl String?
  content   String?
  type      String   // e.g. "URL", "TEXT", "IMAGE", "PDF", "AUDIO"
  status    String   @default("pending") // e.g. "pending", "processing", "completed", "failed"
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  summary   Summary?
  topics    Topic[]
  entities  Entity[]
  chunks    Chunk[]
  flashcards Flashcard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chunk {
  id         String   @id @default(uuid())
  text       String
  embedding  Unsupported("vector(768)")?
  searchVector Unsupported("tsvector")?
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  artifactId String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
}

model Summary {
  id         String   @id @default(uuid())
  text       String
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  artifactId String   @unique
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
}

model Topic {
  id        String     @id @default(uuid())
  name      String
  
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  artifacts Artifact[]

  @@unique([name, userId])
}

model Entity {
  id        String     @id @default(uuid())
  name      String
  type      String     // e.g., "PERSON", "ORGANIZATION", "LOCATION"
  
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  artifacts Artifact[]

  @@unique([name, type, userId])
}

model Flashcard {
  id             String   @id @default(uuid())
  question       String
  answer         String
  
  // SM-2 Spaced Repetition Fields
  nextReviewDate DateTime @default(now())
  interval       Int      @default(0)    // days
  easeFactor     Float    @default(2.5)
  repetitions    Int      @default(0)

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  artifactId     String
  artifact       Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Recommendation {
  id          String   @id @default(uuid())
  title       String
  description String
  reasoning   String
  type        String   // "CONCEPT" or "SYNTHESIS"
  imageUrl    String?
  status      String   @default("UNREAD") // "UNREAD", "SAVED", "DISMISSED"
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}
